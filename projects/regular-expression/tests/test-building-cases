str test_building_cases()
{
    for (sizevalue i = 0; i < building_cases.size(); ++i) {
        auto table = build_regular_table(building_cases[i], functional_operations, INDEX_OF_MAIN_EXCEPTIONS);
        if (length_of_exception_pool(INDEX_OF_MAIN_EXCEPTIONS) != 0) {
            for (sizevalue j = 0; j < length_of_exception_pool(INDEX_OF_MAIN_EXCEPTIONS); ++j) {
                std::cout << "第" + std::to_string(i + 1) + "个测试用例产生了异常\"" + information_of_exception_pool_by_index(INDEX_OF_MAIN_EXCEPTIONS, j) + "\"" << std::endl;
            }
            clear_excpetion_pool(INDEX_OF_MAIN_EXCEPTIONS);
            break;
        }
        if (table != expected_building_cases[i]) {
            return fixed_length("第") + fixed_length(std::to_string(i + 1)) + fixed_length("个测试用例\"") + building_cases[i] + fixed_length("\"与预期不符");
        }
    }
    return fixed_length("所有构建测试示例与预期相符！");
}

